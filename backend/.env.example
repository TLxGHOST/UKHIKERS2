# Copy to .env for local development. Never commit real secrets.
PORT=5000
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
JWT_SECRET=replace-with-a-long-random-secret

# Razorpay credentials from your Razorpay dashboard
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me

# SMTP: Gmail example. Use a Google App Password, not your Gmail password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-google-app-password
EMAIL_FROM=your-email@gmail.com

# Comma-separated exact frontend origins. Example for local + deployed frontend:
FRONTEND_URL=http://localhost:5173,https://your-frontend.vercel.app
